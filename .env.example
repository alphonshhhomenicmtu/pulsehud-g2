# PulseHUD Environment Configuration
# Copy this file to .env and fill in optional credentials.
# PulseHUD runs fully out of the box with live public Hyperliquid + Polymarket APIs
# and an interactive Telegram Desk bridge even without any API keys configured.

# Backend API server port (default: 8792)
PORT=8792

# Optional: Real Telegram Bot integration (from @BotFather)
# When set, PulseHUD polls live incoming messages and delivers confirmed replies & alerts directly to Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Speech-to-Text provider for glasses 4-mic PCM voice commands
# Priority: OPENAI_API_KEY -> DEEPGRAM_API_KEY -> LOCAL_STT_URL (zero-key whisper.cpp server)
# -> auto-detected local whisper-cli binary -> zero-key Browser Web Speech / Voice Bar.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
LOCAL_STT_URL=
LOCAL_WHISPER_BIN=
LOCAL_WHISPER_MODEL=

# Optional: Default public 0x Hyperliquid address to watch via read-only clearinghouseState (zero custody)
WATCHED_HL_ADDRESS=0xecb63caa47c7c4e77f60f1ce858cf28dc2b82b00

# Optional: Force offline replay mode for air-gapped stage demos (true | false)
OFFLINE_REPLAY=false
